# TBA Academy — Next.js env template. Copy to .env.local and fill in.
# Do NOT commit .env.local — it is in .gitignore.

# ─── Database (Sprint 3 — Neon Postgres) ─────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# ─── Auth (Sprint 3) ─────────────────────────────────────────────────────────
SESSION_SECRET=                # 64-byte random hex — `openssl rand -hex 32`
WEBAUTHN_RP_ID=localhost       # production: timboi14masterclass.vercel.app
WEBAUTHN_RP_NAME=TimBoi's Academy

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=noreply@timboi14masterclass.vercel.app

# ─── Encryption-at-rest for personal API keys ────────────────────────────────
TBA_SECRETS_PUB=               # base64 libsodium box public key
TBA_SECRETS_PRIV=              # base64 libsodium box private key

# ─── AI providers ────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=             # for source-map upload via @sentry/nextjs
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Rate limiting (Upstash) ─────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
