{
  "name": "timboi-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-sitting.mjs && node scripts/generate-public-stats.mjs && node scripts/generate-icons.mjs && node scripts/generate-sitemap.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "stats": "node scripts/generate-public-stats.mjs",
    "check:sitting": "node scripts/check-sitting.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "check:bundle": "node scripts/check-deployed-bundle.mjs",
    "check:bundle:local": "node scripts/check-deployed-bundle.mjs --base ./dist",
    "test:e2e": "playwright test -c tests/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/anton": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "mathjs": "^15.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
